# Configuração do scripts/backup-supabase.sh
#
# Copie para .env.backup e preencha. O .env.backup está no .gitignore e NUNCA
# deve ser versionado: ele contém a senha do banco e a passphrase do backup.
#
# Atenção: estas variáveis NÃO usam o prefixo EXPO_PUBLIC_ de propósito. Tudo
# que começa com EXPO_PUBLIC_ é embutido no APK e fica legível para qualquer um
# que baixe o app.

# ── Banco de origem ──────────────────────────────────────────────────────────
# Supabase > Project Settings > Database > Connection string (modo "URI").
# Use a connection string DIRETA (porta 5432), não a do pooler em modo
# transaction (6543): o pg_dump precisa de prepared statements.
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnop:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── Cifragem (obrigatória) ───────────────────────────────────────────────────
# Frase longa, guardada num gerenciador de senhas. SE VOCÊ PERDER ESTA FRASE,
# OS BACKUPS SÃO IRRECUPERÁVEIS — não há como decifrar sem ela.
# Não reaproveite a senha do banco nem a do cPanel.
BACKUP_PASSPHRASE=troque-por-uma-frase-longa-e-unica

# ── Destino no cPanel ────────────────────────────────────────────────────────
# ftps  = envia por FTP sobre TLS (funciona na maioria das hospedagens)
# sftp  = envia por SSH com autenticação por chave (preferível, se disponível)
# none  = só mantém a cópia local
UPLOAD_MODE=ftps

CPANEL_HOST=ftp.seudominio.com.br
CPANEL_USER=usuario_ftp
CPANEL_PASS=senha_do_ftp

# Diretório remoto, FORA de public_html — senão o backup fica baixável pela web.
# O script aborta se o caminho contiver "public_html" ou "www".
CPANEL_REMOTE_DIR=backups_minduni

# Só para UPLOAD_MODE=sftp
CPANEL_SSH_PORT=22

# ── Retenção local ───────────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_KEEP=8
